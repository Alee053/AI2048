{
    "defaults":
    {
        "colours":
        {
            "dark_bg": "#1A1A1A",
            "normal_bg": "#1A1A1A",
            "normal_text": "#FFFFFF",
            "muted_text": "#888888",
            "filled_bar": "#F5A623",
            "unfilled_bar": "#1A1A1A"
        }
    },
"fonts":
    {
        "small": { "name": "fira_code", "size": "14", "regular_path": "", "bold_path": "", "italic_path": "", "bold_italic_path": "" },
        "medium": { "name": "fira_code", "size": "16", "regular_path": "", "bold_path": "", "italic_path": "", "bold_italic_path": "" },
        "large": { "name": "fira_code", "size": "20", "regular_path": "", "bold_path": "", "italic_path": "", "bold_italic_path": "" }
    },
    "UIPanel":
    {
        "bg_colour": "@normal_bg",
        "border_width": "0"
    },
    "UILabel":
    {
        "bg_colour": "@normal_bg",
        "text_colour": "@normal_text",
        "text_alignment": "left"
    },
    "UIButton":
    {
        "bg_colour": "@normal_bg",
        "text_colour": "@normal_text"
    },
    "UIProgressBar":
    {
        "filled_bar": "@filled_bar",
        "unfilled_bar": "@unfilled_bar"
    },
    "UITextBox":
    {
        "bg_colour": "@normal_bg",
        "text_colour": "@normal_text"
    },
    "UILabel.amber":
    {
        "text_colour": "#F5A623"
    },
    "UILabel.cyan":
    {
        "text_colour": "#00C8FF"
    },
    "UILabel.green":
    {
        "text_colour": "#64FF64"
    },
    "UILabel.muted":
    {
        "text_colour": "#AAAAAA"
    },
    "UILabel.section_header":
    {
        "text_colour": "#FFFFFF",
        "font": {
            "name": "fira_code",
            "size": "18",
            "bold": "true"
        }
    },
    "UILabel.history_row":
    {
        "text_colour": "#CCCCCC",
        "font": {
            "name": "fira_code",
            "size": "14"
        }
    },
    "UIScrollingContainer":
    {
        "bg_color": "#1A1A1A"
    }
}