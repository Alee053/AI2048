{
    "defaults":
    {
        "colours":
        {
            "dark_bg": "#1A1A1A",
            "normal_bg": "#1A1A1A",
            "normal_text": "#FFFFFF",
            "muted_text": "#888888",
            "filled_bar": "#F5A623",
            "unfilled_bar": "#1A1A1A"
        }
    },
    "fonts":
    {
        "small": { "name": "pygame_font", "size": "13", "regular_path": "", "bold_path": "", "italic_path": "" },
        "medium": { "name": "pygame_font", "size": "16", "regular_path": "", "bold_path": "", "italic_path": "" },
        "large": { "name": "pygame_font", "size": "22", "regular_path": "", "bold_path": "", "italic_path": "" }
    },
    "UIPanel":
    {
        "bg_colour": "@normal_bg",
        "border_width": "0"
    },
    "UILabel":
    {
        "bg_colour": "@normal_bg",
        "text_colour": "@normal_text"
    },
    "UIButton":
    {
        "bg_colour": "@normal_bg",
        "text_colour": "@normal_text"
    },
    "UIProgressBar":
    {
        "filled_bar": "@filled_bar",
        "unfilled_bar": "@unfilled_bar"
    },
    "UITextBox":
    {
        "bg_colour": "@normal_bg",
        "text_colour": "@normal_text"
    }
}